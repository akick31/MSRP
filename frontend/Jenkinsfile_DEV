pipeline {
    agent any

    environment {
        IMAGE_NAME = 'msrp-frontend-dev'
        CONTAINER_NAME = 'MSRP-Frontend-DEV'
        CONTAINER_NAME_BLUE = 'MSRP-Frontend-DEV-BLUE'
        DOCKERFILE = 'Dockerfile_DEV'
        VITE_API_BASE_URL = credentials('MSRP_VITE_API_BASE_URL_DEV')
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out the MSRP Frontend project...'
                checkout scm
            }
        }

        stage('Get Version') {
            steps {
                script {
                    def latestTag = sh(script: "git describe --tags --abbrev=0 2>/dev/null || echo 'v0.0.0'", returnStdout: true).trim()
                    env.VERSION = latestTag
                    currentBuild.description = "Version: ${latestTag}"
                    currentBuild.displayName = "Build #${env.BUILD_NUMBER} - ${latestTag}"
                }
            }
        }

        stage('Generate .env File') {
            steps {
                script {
                    echo 'Generating .env file...'
                    dir('frontend') {
                        sh "echo 'VITE_API_BASE_URL=${env.VITE_API_BASE_URL}' > .env"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image for MSRP Frontend...'
                dir('frontend') {
                    sh """
                        docker build -f ${DOCKERFILE} -t ${IMAGE_NAME}:latest .
                    """
                }
            }
        }

        stage('Start Blue Container') {
            steps {
                script {
                    sh "docker rm -f ${CONTAINER_NAME_BLUE} || true"
                    dir('frontend') {
                        sh """
                            docker run -d --name ${CONTAINER_NAME_BLUE} \\
                                -p 11520:920 \\
                                --env-file .env \\
                                ${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    sleep(time: 15, unit: 'SECONDS')
                    def healthy = false
                    def attempts = 0
                    def maxAttempts = 30
                    while (!healthy && attempts < maxAttempts) {
                        attempts++
                        try {
                            def status = sh(
                                script: "docker exec ${env.CONTAINER_NAME_BLUE} wget -qO/dev/null http://127.0.0.1:920/ && echo OK || echo FAIL",
                                returnStdout: true
                            ).trim()
                            if (status == 'OK') {
                                healthy = true
                                echo "Blue container is healthy (attempt ${attempts})"
                            }
                        } catch (e) {
                            // not ready yet
                        }
                        if (!healthy) {
                            echo "Waiting for health check... attempt ${attempts}/${maxAttempts}"
                            sleep(time: 5, unit: 'SECONDS')
                        }
                    }
                    if (!healthy) {
                        sh "docker logs ${CONTAINER_NAME_BLUE} --tail=50"
                        sh "docker rm -f ${CONTAINER_NAME_BLUE} || true"
                        error("Blue container failed to become healthy after ${maxAttempts * 5}s - rolled back")
                    }
                }
            }
        }

        stage('Swap Containers') {
            steps {
                script {
                    dir('frontend') {
                        sh """
                            docker stop ${CONTAINER_NAME} || true
                            docker rm ${CONTAINER_NAME} || true
                            docker stop ${CONTAINER_NAME_BLUE} || true
                            docker rm ${CONTAINER_NAME_BLUE} || true
                            docker run -d --restart=always --name ${CONTAINER_NAME} \\
                                -p 920:920 \\
                                --env-file .env \\
                                ${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    echo 'Cleaning up sensitive files...'
                    sh 'rm -f frontend/.env'
                }
            }
        }

        stage('Cleanup Docker System') {
            steps {
                script {
                    echo 'Pruning unused Docker resources...'
                    sh 'docker system prune -f'
                }
            }
        }
    }

    post {
        success {
            echo 'MSRP Frontend DEV deployed successfully!'
        }
        failure {
            echo 'MSRP Frontend DEV deployment failed.'
            sh "docker rm -f ${CONTAINER_NAME_BLUE} || true"
        }
    }
}

pipeline {
    agent any

    environment {
        IMAGE_NAME = 'msrp-backend-prd'
        CONTAINER_NAME = 'MSRP-Backend-PRD'
        CONTAINER_NAME_BLUE = 'MSRP-Backend-PRD-BLUE'
        DOCKERFILE = 'Dockerfile_PRD'
        APP_PROPERTIES = './src/main/resources/application.properties'
        DB_USERNAME = credentials('DB_USERNAME')
        DB_PASSWORD = credentials('DB_PASSWORD')
        ADMIN_API_KEY = credentials('MSRP_ADMIN_API_KEY')
        MAIL_USERNAME = credentials('MSRP_MAIL_USERNAME')
        MAIL_PASSWORD = credentials('MSRP_MAIL_PASSWORD')
        JAVA_HOME = '/usr/lib/jvm/java-17-openjdk-amd64'
        PATH = "/usr/lib/jvm/java-17-openjdk-amd64/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out the MSRP Backend project...'
                checkout scm
            }
        }

        stage('Get Version') {
            steps {
                script {
                    def latestTag = sh(script: "git describe --tags --abbrev=0 2>/dev/null || echo '1.0.0'", returnStdout: true).trim()

                    echo "Current Version: ${latestTag}"

                    env.VERSION = latestTag

                    currentBuild.description = "Version: ${env.VERSION}"
                    currentBuild.displayName = "Build #${env.BUILD_NUMBER} - Version: ${env.VERSION}"
                }
            }
        }

        stage('Build') {
            steps {
                echo 'Creating the production properties file...'
                dir('backend') {
                    script {
                        def propertiesContent = """
                            server.port=1010
                            spring.datasource.url=jdbc:mariadb://51.81.32.234:3306/msrp
                            spring.datasource.username=${env.DB_USERNAME}
                            spring.datasource.password=${env.DB_PASSWORD}
                            spring.datasource.driver-class-name=org.mariadb.jdbc.Driver
                            spring.jpa.hibernate.ddl-auto=update
                            spring.jpa.show-sql=false
                            spring.jackson.property-naming-strategy=SNAKE_CASE
                            spring.jpa.open-in-view=false
                            msrp.admin.api-key=${env.ADMIN_API_KEY}
                            spring.mail.host=smtp.gmail.com
                            spring.mail.port=587
                            spring.mail.username=${env.MAIL_USERNAME}
                            spring.mail.password=${env.MAIL_PASSWORD}
                            spring.mail.properties.mail.smtp.auth=true
                            spring.mail.properties.mail.smtp.starttls.enable=true
                            management.endpoints.web.exposure.include=health
                            management.endpoint.health.show-details=always
                            management.health.defaults.enabled=true
                            management.health.db.enabled=true
                            logging.level.org.hibernate=warn
                            logging.level.org.hibernate.SQL=warn
                            logging.level.org.hibernate.type.descriptor.sql=warn
                        """.stripIndent()

                        writeFile file: "${env.APP_PROPERTIES}", text: propertiesContent
                    }

                    echo 'Building the MSRP Backend project...'
                    sh 'chmod +x gradlew || true'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Build New Docker Image') {
            steps {
                script {
                    echo 'Building the new MSRP Backend Docker image...'
                    dir('backend') {
                        sh """
                            docker build -f ${DOCKERFILE} -t ${IMAGE_NAME}:${DOCKERFILE} .
                        """
                    }
                }
            }
        }

        stage('Start Blue Container') {
            steps {
                sh "docker rm -f ${CONTAINER_NAME_BLUE} || true"
                sh """
                    docker run -d --name ${CONTAINER_NAME_BLUE} \\
                        -p 11510:1010 \\
                        ${IMAGE_NAME}:${DOCKERFILE}
                """
            }
        }

        stage('Health Check') {
            steps {
                script {
                    sleep(time: 40, unit: 'SECONDS')
                    def healthy = false
                    def attempts = 0
                    def maxAttempts = 30
                    while (!healthy && attempts < maxAttempts) {
                        attempts++
                        try {
                            def status = sh(
                                script: "docker exec ${env.CONTAINER_NAME_BLUE} curl -sf --max-time 15 http://127.0.0.1:1010/actuator/health -o /dev/null && echo OK || echo FAIL",
                                returnStdout: true
                            ).trim()
                            if (status == 'OK') {
                                healthy = true
                                echo "Blue container is healthy (attempt ${attempts})"
                            }
                        } catch (e) {
                            // not ready yet
                        }
                        if (!healthy) {
                            echo "Waiting for health check... attempt ${attempts}/${maxAttempts}"
                            sleep(time: 5, unit: 'SECONDS')
                        }
                    }
                    if (!healthy) {
                        sh "docker logs ${CONTAINER_NAME_BLUE} --tail=50"
                        sh "docker rm -f ${CONTAINER_NAME_BLUE} || true"
                        error("Blue container failed to become healthy after ${maxAttempts * 5}s - rolled back")
                    }
                }
            }
        }

        stage('Swap Containers') {
            steps {
                sh """
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    docker stop ${CONTAINER_NAME_BLUE} || true
                    docker rm ${CONTAINER_NAME_BLUE} || true
                    docker run --network="host" -d --restart=always --name ${CONTAINER_NAME} \\
                        ${IMAGE_NAME}:${DOCKERFILE}
                """
            }
        }

        stage('Cleanup Docker System') {
            steps {
                script {
                    echo 'Pruning unused Docker resources...'
                    sh 'docker system prune -a --force'
                }
            }
        }
    }

    post {
        success {
            echo 'MSRP Backend PRD has been successfully deployed!'
        }
        failure {
            echo 'An error occurred during the MSRP Backend PRD deployment.'
            sh "docker rm -f ${CONTAINER_NAME_BLUE} || true"
        }
    }
}
